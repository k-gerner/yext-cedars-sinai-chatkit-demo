{
  "version": "1.0",
  "name": "sources-widget",
  "template": "{\n  \"type\": \"Card\",\n  \"size\": \"md\",\n  \"padding\": 4,\n  \"children\": [\n    {\n      \"type\": \"Title\",\n      \"value\": \"Doctor results\",\n      \"size\": \"md\",\n      \"weight\": \"semibold\"\n    },\n    {\n      \"type\": \"Divider\",\n      \"color\": \"subtle\"\n    },\n    {\n      \"type\": \"Col\",\n      \"gap\": 2,\n      \"children\": [{% for source in reference_sources %}\n        {\n          \"type\": \"Row\",\n          \"align\": \"center\",\n          \"gap\": 3,\n          \"width\": \"100%\",\n          \"children\": [\n            {\n              \"type\": \"Image\",\n              \"src\": {{ avatar_url | tojson }},\n              \"alt\": {{ (source.title ~ ' avatar') | tojson }},\n              \"size\": 40,\n              \"fit\": \"cover\",\n              \"radius\": \"full\"\n            },\n            {\n              \"type\": \"Col\",\n              \"flex\": 1,\n              \"gap\": 0.5,\n              \"children\": [\n                {\n                  \"type\": \"Title\",\n                  \"value\": {{ source.title | tojson }},\n                  \"size\": \"sm\",\n                  \"weight\": \"semibold\"\n                }{% if source.subtitle %},\n                {\n                  \"type\": \"Text\",\n                  \"value\": {{ source.subtitle.replace('\\n', ', ') | tojson }},\n                  \"size\": \"xs\",\n                  \"color\": \"secondary\"\n                }{% endif %}\n              ]\n            },\n            {\n              \"type\": \"Button\",\n              \"label\": \"Book\",\n              \"pill\": true,\n              \"size\": \"sm\",\n              \"color\": \"secondary\",\n              \"variant\": \"solid\",\n              \"onClickAction\": {\n                \"type\": \"open_reference_page\",\n                \"payload\": {\n                  \"destination\": {{ source.destination | tojson }}\n                },\n                \"handler\": \"client\"\n              }\n            }\n          ]\n        }{% if not loop.last %},\n        {\n          \"type\": \"Divider\",\n          \"color\": \"subtle\"\n        }{% endif %}{% if not loop.last %},{% endif %}{% endfor %}]\n    }\n  ]\n}"
}
